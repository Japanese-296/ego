import 'package:flutter/material.dart';
import 'package:google_fonts/google_fonts.dart';
import 'package:fl_chart/fl_chart.dart';

class AnalyticsScreen extends StatefulWidget {
  const AnalyticsScreen({super.key});

  @override
  State<AnalyticsScreen> createState() => _AnalyticsScreenState();
}

class _AnalyticsScreenState extends State<AnalyticsScreen>
    with SingleTickerProviderStateMixin {
  late TabController _tabController;
  int _selectedPeriod = 1; // 0=Week, 1=Month, 2=Year

  final List<String> _periods = ['Week', 'Month', 'Year'];

  // Weekly XP data
  final List<FlSpot> _weeklyXp = [
    const FlSpot(0, 120),
    const FlSpot(1, 200),
    const FlSpot(2, 150),
    const FlSpot(3, 280),
    const FlSpot(4, 220),
    const FlSpot(5, 310),
    const FlSpot(6, 260),
  ];

  // Monthly study hours
  final List<BarChartGroupData> _monthlyHours = List.generate(4, (i) {
    final values = [12.5, 18.0, 15.5, 22.0];
    return BarChartGroupData(
      x: i,
      barRods: [
        BarChartRodData(
          toY: values[i],
          gradient: const LinearGradient(
            colors: [Color(0xFF7C3AED), Color(0xFFA855F7)],
            begin: Alignment.bottomCenter,
            end: Alignment.topCenter,
          ),
          width: 28,
          borderRadius: const BorderRadius.vertical(top: Radius.circular(6)),
        ),
      ],
    );
  });

  final List<Map<String, dynamic>> _skillStats = [
    {'skill': 'Vocabulary', 'score': 0.72, 'color': const Color(0xFF7C3AED)},
    {'skill': 'Grammar', 'score': 0.55, 'color': const Color(0xFFEAB308)},
    {'skill': 'Reading', 'score': 0.40, 'color': const Color(0xFF06B6D4)},
    {'skill': 'Listening', 'score': 0.30, 'color': const Color(0xFFEC4899)},
    {'skill': 'Speaking', 'score': 0.20, 'color': const Color(0xFF059669)},
    {'skill': 'Writing', 'score': 0.15, 'color': const Color(0xFFF97316)},
  ];

  final List<Map<String, dynamic>> _achievements = [
    {
      'title': '7-Day Streak',
      'icon': Icons.local_fire_department_rounded,
      'color': const Color(0xFFF97316),
      'date': 'May 20',
      'xp': 100,
    },
    {
      'title': '100 Words Mastered',
      'icon': Icons.abc_rounded,
      'color': const Color(0xFF7C3AED),
      'date': 'May 18',
      'xp': 200,
    },
    {
      'title': 'Grammar Pro',
      'icon': Icons.edit_note_rounded,
      'color': const Color(0xFFEAB308),
      'date': 'May 15',
      'xp': 150,
    },
    {
      'title': 'First Lesson',
      'icon': Icons.school_rounded,
      'color': const Color(0xFF06B6D4),
      'date': 'May 10',
      'xp': 50,
    },
    {
      'title': 'Speed Reader',
      'icon': Icons.speed_rounded,
      'color': const Color(0xFFEC4899),
      'date': 'May 8',
      'xp': 75,
    },
  ];

  final List<Map<String, dynamic>> _leaderboard = [
    {
      'name': 'Priya Sharma',
      'xp': 4200,
      'avatar': 'P',
      'color': const Color(0xFFEC4899),
      'rank': 1,
    },
    {
      'name': 'Rahul Verma',
      'xp': 3850,
      'avatar': 'R',
      'color': const Color(0xFF06B6D4),
      'rank': 2,
    },
    {
      'name': 'Arjun (You)',
      'xp': 2840,
      'avatar': 'A',
      'color': const Color(0xFF7C3AED),
      'rank': 3,
    },
    {
      'name': 'Sneha Patel',
      'xp': 2600,
      'avatar': 'S',
      'color': const Color(0xFF059669),
      'rank': 4,
    },
    {
      'name': 'Vikram Singh',
      'xp': 2100,
      'avatar': 'V',
      'color': const Color(0xFFF97316),
      'rank': 5,
    },
  ];

  @override
  void initState() {
    super.initState();
    _tabController = TabController(length: 3, vsync: this);
  }

  @override
  void dispose() {
    _tabController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final isDark = theme.brightness == Brightness.dark;

    return Scaffold(
      backgroundColor: isDark
          ? const Color(0xFF0D0A1A)
          : const Color(0xFFF8F7FF),
      body: SafeArea(
        child: Column(
          children: [
            _buildHeader(isDark),
            _buildTabBar(isDark),
            Expanded(
              child: TabBarView(
                controller: _tabController,
                children: [
                  _buildProgressTab(isDark),
                  _buildAchievementsTab(isDark),
                  _buildLeaderboardTab(isDark),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildHeader(bool isDark) {
    return Padding(
      padding: const EdgeInsets.fromLTRB(20, 16, 20, 8),
      child: Row(
        children: [
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  'Analytics',
                  style: GoogleFonts.outfit(
                    fontSize: 22,
                    fontWeight: FontWeight.w800,
                    color: isDark
                        ? const Color(0xFFE8E0FF)
                        : const Color(0xFF1A1A2E),
                  ),
                ),
                Text(
                  'Track your learning journey',
                  style: GoogleFonts.outfit(
                    fontSize: 13,
                    color: isDark
                        ? const Color(0xFF9D8EC4)
                        : const Color(0xFF6B5B8E),
                  ),
                ),
              ],
            ),
          ),
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
            decoration: BoxDecoration(
              color: const Color(0xFF7C3AED).withAlpha(26),
              borderRadius: BorderRadius.circular(20),
              border: Border.all(color: const Color(0xFF7C3AED).withAlpha(77)),
            ),
            child: Row(
              mainAxisSize: MainAxisSize.min,
              children: [
                const Icon(
                  Icons.trending_up_rounded,
                  color: Color(0xFF7C3AED),
                  size: 16,
                ),
                const SizedBox(width: 4),
                Text(
                  '+12% this week',
                  style: GoogleFonts.outfit(
                    fontSize: 12,
                    fontWeight: FontWeight.w600,
                    color: const Color(0xFF7C3AED),
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildTabBar(bool isDark) {
    return Container(
      margin: const EdgeInsets.symmetric(horizontal: 20, vertical: 4),
      decoration: BoxDecoration(
        color: isDark ? const Color(0xFF1A1025) : const Color(0xFFEDE9FE),
        borderRadius: BorderRadius.circular(12),
      ),
      child: TabBar(
        controller: _tabController,
        indicator: BoxDecoration(
          color: const Color(0xFF7C3AED),
          borderRadius: BorderRadius.circular(10),
        ),
        indicatorSize: TabBarIndicatorSize.tab,
        labelColor: Colors.white,
        unselectedLabelColor: isDark
            ? const Color(0xFF9D8EC4)
            : const Color(0xFF6B5B8E),
        labelStyle: GoogleFonts.outfit(
          fontSize: 13,
          fontWeight: FontWeight.w600,
        ),
        unselectedLabelStyle: GoogleFonts.outfit(
          fontSize: 13,
          fontWeight: FontWeight.w500,
        ),
        dividerColor: Colors.transparent,
        tabs: const [
          Tab(text: 'Progress'),
          Tab(text: 'Achievements'),
          Tab(text: 'Leaderboard'),
        ],
      ),
    );
  }

  Widget _buildProgressTab(bool isDark) {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(20),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          _buildKpiRow(isDark),
          const SizedBox(height: 20),
          _buildPeriodSelector(isDark),
          const SizedBox(height: 16),
          _buildXpChart(isDark),
          const SizedBox(height: 20),
          _buildStudyHoursChart(isDark),
          const SizedBox(height: 20),
          _buildSkillBreakdown(isDark),
          const SizedBox(height: 80),
        ],
      ),
    );
  }

  Widget _buildKpiRow(bool isDark) {
    final kpis = [
      {
        'label': 'Total XP',
        'value': '2,840',
        'icon': Icons.bolt_rounded,
        'color': const Color(0xFF7C3AED),
      },
      {
        'label': 'Streak',
        'value': '14d',
        'icon': Icons.local_fire_department_rounded,
        'color': const Color(0xFFF97316),
      },
      {
        'label': 'Hours',
        'value': '43h',
        'icon': Icons.timer_rounded,
        'color': const Color(0xFF06B6D4),
      },
      {
        'label': 'Words',
        'value': '312',
        'icon': Icons.abc_rounded,
        'color': const Color(0xFF059669),
      },
    ];

    return Row(
      children: kpis.map((kpi) {
        final color = kpi['color'] as Color;
        return Expanded(
          child: Container(
            margin: const EdgeInsets.only(right: 8),
            padding: const EdgeInsets.symmetric(vertical: 12, horizontal: 8),
            decoration: BoxDecoration(
              color: isDark ? const Color(0xFF1E1535) : Colors.white,
              borderRadius: BorderRadius.circular(14),
              border: Border.all(color: color.withAlpha(51)),
            ),
            child: Column(
              children: [
                Icon(kpi['icon'] as IconData, color: color, size: 20),
                const SizedBox(height: 4),
                Text(
                  kpi['value'] as String,
                  style: GoogleFonts.outfit(
                    fontSize: 14,
                    fontWeight: FontWeight.w800,
                    color: isDark
                        ? const Color(0xFFE8E0FF)
                        : const Color(0xFF1A1A2E),
                  ),
                ),
                Text(
                  kpi['label'] as String,
                  style: GoogleFonts.outfit(
                    fontSize: 10,
                    color: isDark
                        ? const Color(0xFF9D8EC4)
                        : const Color(0xFF6B5B8E),
                  ),
                ),
              ],
            ),
          ),
        );
      }).toList(),
    );
  }

  Widget _buildPeriodSelector(bool isDark) {
    return Row(
      children: List.generate(_periods.length, (i) {
        final selected = i == _selectedPeriod;
        return GestureDetector(
          onTap: () => setState(() => _selectedPeriod = i),
          child: Container(
            margin: const EdgeInsets.only(right: 8),
            padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 7),
            decoration: BoxDecoration(
              color: selected
                  ? const Color(0xFF7C3AED)
                  : (isDark ? const Color(0xFF1E1535) : Colors.white),
              borderRadius: BorderRadius.circular(20),
              border: Border.all(
                color: selected
                    ? const Color(0xFF7C3AED)
                    : (isDark
                          ? const Color(0x33A855F7)
                          : const Color(0x22A855F7)),
              ),
            ),
            child: Text(
              _periods[i],
              style: GoogleFonts.outfit(
                fontSize: 13,
                fontWeight: FontWeight.w600,
                color: selected
                    ? Colors.white
                    : (isDark
                          ? const Color(0xFF9D8EC4)
                          : const Color(0xFF6B5B8E)),
              ),
            ),
          ),
        );
      }),
    );
  }

  Widget _buildXpChart(bool isDark) {
    return Container(
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: isDark ? const Color(0xFF1E1535) : Colors.white,
        borderRadius: BorderRadius.circular(20),
        border: Border.all(
          color: isDark ? const Color(0x33A855F7) : const Color(0x22A855F7),
        ),
        boxShadow: [
          BoxShadow(
            color: const Color(0xFF7C3AED).withAlpha(15),
            blurRadius: 16,
            offset: const Offset(0, 4),
          ),
        ],
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Text(
                'XP Earned',
                style: GoogleFonts.outfit(
                  fontSize: 15,
                  fontWeight: FontWeight.w700,
                  color: isDark
                      ? const Color(0xFFE8E0FF)
                      : const Color(0xFF1A1A2E),
                ),
              ),
              const Spacer(),
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
                decoration: BoxDecoration(
                  color: const Color(0xFF059669).withAlpha(26),
                  borderRadius: BorderRadius.circular(8),
                ),
                child: Text(
                  '↑ 1,540 this week',
                  style: GoogleFonts.outfit(
                    fontSize: 11,
                    fontWeight: FontWeight.w600,
                    color: const Color(0xFF059669),
                  ),
                ),
              ),
            ],
          ),
          const SizedBox(height: 16),
          SizedBox(
            height: 140,
            child: LineChart(
              LineChartData(
                gridData: FlGridData(
                  show: true,
                  drawVerticalLine: false,
                  horizontalInterval: 100,
                  getDrawingHorizontalLine: (value) => FlLine(
                    color: isDark
                        ? const Color(0x22A855F7)
                        : const Color(0x11A855F7),
                    strokeWidth: 1,
                  ),
                ),
                titlesData: FlTitlesData(
                  leftTitles: const AxisTitles(
                    sideTitles: SideTitles(showTitles: false),
                  ),
                  rightTitles: const AxisTitles(
                    sideTitles: SideTitles(showTitles: false),
                  ),
                  topTitles: const AxisTitles(
                    sideTitles: SideTitles(showTitles: false),
                  ),
                  bottomTitles: AxisTitles(
                    sideTitles: SideTitles(
                      showTitles: true,
                      getTitlesWidget: (value, meta) {
                        const days = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
                        return Text(
                          days[value.toInt()],
                          style: GoogleFonts.outfit(
                            fontSize: 11,
                            color: isDark
                                ? const Color(0xFF9D8EC4)
                                : const Color(0xFF6B5B8E),
                          ),
                        );
                      },
                    ),
                  ),
                ),
                borderData: FlBorderData(show: false),
                lineBarsData: [
                  LineChartBarData(
                    spots: _weeklyXp,
                    isCurved: true,
                    gradient: const LinearGradient(
                      colors: [Color(0xFF7C3AED), Color(0xFF06B6D4)],
                    ),
                    barWidth: 3,
                    isStrokeCapRound: true,
                    dotData: FlDotData(
                      show: true,
                      getDotPainter: (spot, percent, barData, index) =>
                          FlDotCirclePainter(
                            radius: 4,
                            color: const Color(0xFF7C3AED),
                            strokeWidth: 2,
                            strokeColor: Colors.white,
                          ),
                    ),
                    belowBarData: BarAreaData(
                      show: true,
                      gradient: LinearGradient(
                        colors: [
                          const Color(0xFF7C3AED).withAlpha(77),
                          const Color(0xFF7C3AED).withAlpha(0),
                        ],
                        begin: Alignment.topCenter,
                        end: Alignment.bottomCenter,
                      ),
                    ),
                  ),
                ],
                minX: 0,
                maxX: 6,
                minY: 0,
                maxY: 350,
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildStudyHoursChart(bool isDark) {
    return Container(
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: isDark ? const Color(0xFF1E1535) : Colors.white,
        borderRadius: BorderRadius.circular(20),
        border: Border.all(
          color: isDark ? const Color(0x33A855F7) : const Color(0x22A855F7),
        ),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            'Study Hours by Week',
            style: GoogleFonts.outfit(
              fontSize: 15,
              fontWeight: FontWeight.w700,
              color: isDark ? const Color(0xFFE8E0FF) : const Color(0xFF1A1A2E),
            ),
          ),
          const SizedBox(height: 16),
          SizedBox(
            height: 130,
            child: BarChart(
              BarChartData(
                alignment: BarChartAlignment.spaceAround,
                maxY: 25,
                barGroups: _monthlyHours,
                gridData: FlGridData(
                  show: true,
                  drawVerticalLine: false,
                  horizontalInterval: 5,
                  getDrawingHorizontalLine: (value) => FlLine(
                    color: isDark
                        ? const Color(0x22A855F7)
                        : const Color(0x11A855F7),
                    strokeWidth: 1,
                  ),
                ),
                borderData: FlBorderData(show: false),
                titlesData: FlTitlesData(
                  leftTitles: const AxisTitles(
                    sideTitles: SideTitles(showTitles: false),
                  ),
                  rightTitles: const AxisTitles(
                    sideTitles: SideTitles(showTitles: false),
                  ),
                  topTitles: const AxisTitles(
                    sideTitles: SideTitles(showTitles: false),
                  ),
                  bottomTitles: AxisTitles(
                    sideTitles: SideTitles(
                      showTitles: true,
                      getTitlesWidget: (value, meta) {
                        const weeks = ['Wk 1', 'Wk 2', 'Wk 3', 'Wk 4'];
                        return Text(
                          weeks[value.toInt()],
                          style: GoogleFonts.outfit(
                            fontSize: 11,
                            color: isDark
                                ? const Color(0xFF9D8EC4)
                                : const Color(0xFF6B5B8E),
                          ),
                        );
                      },
                    ),
                  ),
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildSkillBreakdown(bool isDark) {
    return Container(
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: isDark ? const Color(0xFF1E1535) : Colors.white,
        borderRadius: BorderRadius.circular(20),
        border: Border.all(
          color: isDark ? const Color(0x33A855F7) : const Color(0x22A855F7),
        ),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            'Skill Breakdown',
            style: GoogleFonts.outfit(
              fontSize: 15,
              fontWeight: FontWeight.w700,
              color: isDark ? const Color(0xFFE8E0FF) : const Color(0xFF1A1A2E),
            ),
          ),
          const SizedBox(height: 14),
          ..._skillStats.map((s) => _buildSkillRow(s, isDark)),
        ],
      ),
    );
  }

  Widget _buildSkillRow(Map<String, dynamic> skill, bool isDark) {
    final color = skill['color'] as Color;
    final score = skill['score'] as double;

    return Padding(
      padding: const EdgeInsets.only(bottom: 12),
      child: Row(
        children: [
          SizedBox(
            width: 80,
            child: Text(
              skill['skill'] as String,
              style: GoogleFonts.outfit(
                fontSize: 13,
                fontWeight: FontWeight.w500,
                color: isDark
                    ? const Color(0xFFCBBEF0)
                    : const Color(0xFF4C4469),
              ),
            ),
          ),
          Expanded(
            child: ClipRRect(
              borderRadius: BorderRadius.circular(6),
              child: LinearProgressIndicator(
                value: score,
                backgroundColor: isDark
                    ? const Color(0xFF2D1B4E)
                    : const Color(0xFFEDE9FE),
                valueColor: AlwaysStoppedAnimation<Color>(color),
                minHeight: 8,
              ),
            ),
          ),
          const SizedBox(width: 10),
          SizedBox(
            width: 36,
            child: Text(
              '${(score * 100).toInt()}%',
              style: GoogleFonts.outfit(
                fontSize: 12,
                fontWeight: FontWeight.w700,
                color: color,
              ),
              textAlign: TextAlign.right,
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildAchievementsTab(bool isDark) {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(20),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          _buildAchievementSummary(isDark),
          const SizedBox(height: 20),
          Text(
            'Recent Achievements',
            style: GoogleFonts.outfit(
              fontSize: 16,
              fontWeight: FontWeight.w700,
              color: isDark ? const Color(0xFFE8E0FF) : const Color(0xFF1A1A2E),
            ),
          ),
          const SizedBox(height: 14),
          ..._achievements.map((a) => _buildAchievementCard(a, isDark)),
          const SizedBox(height: 20),
          Text(
            'Locked Achievements',
            style: GoogleFonts.outfit(
              fontSize: 16,
              fontWeight: FontWeight.w700,
              color: isDark ? const Color(0xFFE8E0FF) : const Color(0xFF1A1A2E),
            ),
          ),
          const SizedBox(height: 14),
          _buildLockedAchievements(isDark),
          const SizedBox(height: 80),
        ],
      ),
    );
  }

  Widget _buildAchievementSummary(bool isDark) {
    return Container(
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        gradient: const LinearGradient(
          colors: [Color(0xFF7C3AED), Color(0xFF06B6D4)],
          begin: Alignment.topLeft,
          end: Alignment.bottomRight,
        ),
        borderRadius: BorderRadius.circular(20),
        boxShadow: [
          BoxShadow(
            color: const Color(0xFF7C3AED).withAlpha(77),
            blurRadius: 16,
            offset: const Offset(0, 6),
          ),
        ],
      ),
      child: Row(
        children: [
          const Icon(Icons.emoji_events_rounded, color: Colors.white, size: 40),
          const SizedBox(width: 16),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  '5 Achievements Unlocked',
                  style: GoogleFonts.outfit(
                    fontSize: 16,
                    fontWeight: FontWeight.w700,
                    color: Colors.white,
                  ),
                ),
                Text(
                  'Keep going! 3 more to unlock',
                  style: GoogleFonts.outfit(
                    fontSize: 13,
                    color: Colors.white70,
                  ),
                ),
              ],
            ),
          ),
          Column(
            children: [
              Text(
                '575',
                style: GoogleFonts.outfit(
                  fontSize: 22,
                  fontWeight: FontWeight.w800,
                  color: Colors.white,
                ),
              ),
              Text(
                'Total XP',
                style: GoogleFonts.outfit(fontSize: 11, color: Colors.white70),
              ),
            ],
          ),
        ],
      ),
    );
  }

  Widget _buildAchievementCard(Map<String, dynamic> achievement, bool isDark) {
    final color = achievement['color'] as Color;

    return Container(
      margin: const EdgeInsets.only(bottom: 10),
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
        color: isDark ? const Color(0xFF1E1535) : Colors.white,
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: color.withAlpha(51)),
      ),
      child: Row(
        children: [
          Container(
            width: 44,
            height: 44,
            decoration: BoxDecoration(
              color: color.withAlpha(38),
              shape: BoxShape.circle,
            ),
            child: Icon(
              achievement['icon'] as IconData,
              color: color,
              size: 22,
            ),
          ),
          const SizedBox(width: 12),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  achievement['title'] as String,
                  style: GoogleFonts.outfit(
                    fontSize: 14,
                    fontWeight: FontWeight.w700,
                    color: isDark
                        ? const Color(0xFFE8E0FF)
                        : const Color(0xFF1A1A2E),
                  ),
                ),
                Text(
                  'Earned on ${achievement['date']}',
                  style: GoogleFonts.outfit(
                    fontSize: 12,
                    color: isDark
                        ? const Color(0xFF9D8EC4)
                        : const Color(0xFF6B5B8E),
                  ),
                ),
              ],
            ),
          ),
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
            decoration: BoxDecoration(
              color: const Color(0xFFEAB308).withAlpha(38),
              borderRadius: BorderRadius.circular(10),
            ),
            child: Row(
              mainAxisSize: MainAxisSize.min,
              children: [
                const Icon(
                  Icons.bolt_rounded,
                  color: Color(0xFFEAB308),
                  size: 14,
                ),
                Text(
                  '+${achievement['xp']}',
                  style: GoogleFonts.outfit(
                    fontSize: 12,
                    fontWeight: FontWeight.w700,
                    color: const Color(0xFFEAB308),
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildLockedAchievements(bool isDark) {
    final locked = [
      {
        'title': '30-Day Streak',
        'icon': Icons.local_fire_department_rounded,
        'req': 'Study 30 days in a row',
      },
      {
        'title': '500 Words Master',
        'icon': Icons.abc_rounded,
        'req': 'Learn 500 vocabulary words',
      },
      {
        'title': 'B2 Achiever',
        'icon': Icons.school_rounded,
        'req': 'Reach B2 CEFR level',
      },
    ];

    return Column(
      children: locked.map((l) {
        return Container(
          margin: const EdgeInsets.only(bottom: 10),
          padding: const EdgeInsets.all(14),
          decoration: BoxDecoration(
            color: isDark ? const Color(0xFF1A1025) : const Color(0xFFF5F3FF),
            borderRadius: BorderRadius.circular(14),
            border: Border.all(
              color: isDark ? const Color(0x22A855F7) : const Color(0x11A855F7),
            ),
          ),
          child: Row(
            children: [
              Container(
                width: 44,
                height: 44,
                decoration: BoxDecoration(
                  color: isDark
                      ? const Color(0xFF2D1B4E)
                      : const Color(0xFFEDE9FE),
                  shape: BoxShape.circle,
                ),
                child: Icon(
                  l['icon'] as IconData,
                  color: isDark
                      ? const Color(0xFF4C3D6B)
                      : const Color(0xFFCBBEF0),
                  size: 22,
                ),
              ),
              const SizedBox(width: 12),
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      l['title'] as String,
                      style: GoogleFonts.outfit(
                        fontSize: 14,
                        fontWeight: FontWeight.w700,
                        color: isDark
                            ? const Color(0xFF4C3D6B)
                            : const Color(0xFFCBBEF0),
                      ),
                    ),
                    Text(
                      l['req'] as String,
                      style: GoogleFonts.outfit(
                        fontSize: 12,
                        color: isDark
                            ? const Color(0xFF4C3D6B)
                            : const Color(0xFFCBBEF0),
                      ),
                    ),
                  ],
                ),
              ),
              const Icon(
                Icons.lock_rounded,
                color: Color(0xFFCBBEF0),
                size: 18,
              ),
            ],
          ),
        );
      }).toList(),
    );
  }

  Widget _buildLeaderboardTab(bool isDark) {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(20),
      child: Column(
        children: [
          _buildTopThree(isDark),
          const SizedBox(height: 20),
          ..._leaderboard
              .skip(3)
              .map((user) => _buildLeaderboardRow(user, isDark)),
          const SizedBox(height: 80),
        ],
      ),
    );
  }

  Widget _buildTopThree(bool isDark) {
    final top3 = _leaderboard.take(3).toList();

    return Container(
      padding: const EdgeInsets.all(20),
      decoration: BoxDecoration(
        gradient: LinearGradient(
          colors: isDark
              ? [const Color(0xFF1E1535), const Color(0xFF2D1B4E)]
              : [const Color(0xFFEDE9FE), const Color(0xFFF5F3FF)],
          begin: Alignment.topLeft,
          end: Alignment.bottomRight,
        ),
        borderRadius: BorderRadius.circular(20),
        border: Border.all(
          color: isDark ? const Color(0x33A855F7) : const Color(0x22A855F7),
        ),
      ),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceEvenly,
        crossAxisAlignment: CrossAxisAlignment.end,
        children: [
          _buildPodiumItem(top3[1], 2, 80, isDark),
          _buildPodiumItem(top3[0], 1, 100, isDark),
          _buildPodiumItem(top3[2], 3, 70, isDark),
        ],
      ),
    );
  }

  Widget _buildPodiumItem(
    Map<String, dynamic> user,
    int rank,
    double height,
    bool isDark,
  ) {
    final color = user['color'] as Color;
    final isYou = (user['name'] as String).contains('You');

    return Column(
      children: [
        if (rank == 1)
          const Icon(
            Icons.emoji_events_rounded,
            color: Color(0xFFEAB308),
            size: 24,
          ),
        Container(
          width: 44,
          height: 44,
          decoration: BoxDecoration(
            shape: BoxShape.circle,
            color: color.withAlpha(51),
            border: Border.all(
              color: isYou ? const Color(0xFF7C3AED) : color.withAlpha(102),
              width: isYou ? 2 : 1,
            ),
          ),
          child: Center(
            child: Text(
              user['avatar'] as String,
              style: GoogleFonts.outfit(
                fontSize: 18,
                fontWeight: FontWeight.w800,
                color: color,
              ),
            ),
          ),
        ),
        const SizedBox(height: 6),
        Text(
          (user['name'] as String).split(' ').first,
          style: GoogleFonts.outfit(
            fontSize: 11,
            fontWeight: FontWeight.w600,
            color: isDark ? const Color(0xFFCBBEF0) : const Color(0xFF4C4469),
          ),
        ),
        Text(
          '${user['xp']} XP',
          style: GoogleFonts.outfit(
            fontSize: 11,
            fontWeight: FontWeight.w700,
            color: color,
          ),
        ),
        const SizedBox(height: 6),
        Container(
          width: 60,
          height: height,
          decoration: BoxDecoration(
            color: color.withAlpha(51),
            borderRadius: const BorderRadius.vertical(top: Radius.circular(8)),
            border: Border.all(color: color.withAlpha(77)),
          ),
          child: Center(
            child: Text(
              '#$rank',
              style: GoogleFonts.outfit(
                fontSize: 18,
                fontWeight: FontWeight.w800,
                color: color,
              ),
            ),
          ),
        ),
      ],
    );
  }

  Widget _buildLeaderboardRow(Map<String, dynamic> user, bool isDark) {
    final color = user['color'] as Color;
    final isYou = (user['name'] as String).contains('You');

    return Container(
      margin: const EdgeInsets.only(bottom: 10),
      padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 12),
      decoration: BoxDecoration(
        color: isYou
            ? const Color(0xFF7C3AED).withAlpha(26)
            : (isDark ? const Color(0xFF1E1535) : Colors.white),
        borderRadius: BorderRadius.circular(14),
        border: Border.all(
          color: isYou
              ? const Color(0xFF7C3AED).withAlpha(77)
              : (isDark ? const Color(0x33A855F7) : const Color(0x22A855F7)),
        ),
      ),
      child: Row(
        children: [
          Text(
            '#${user['rank']}',
            style: GoogleFonts.outfit(
              fontSize: 14,
              fontWeight: FontWeight.w700,
              color: isDark ? const Color(0xFF9D8EC4) : const Color(0xFF6B5B8E),
            ),
          ),
          const SizedBox(width: 12),
          CircleAvatar(
            radius: 18,
            backgroundColor: color.withAlpha(51),
            child: Text(
              user['avatar'] as String,
              style: GoogleFonts.outfit(
                fontSize: 14,
                fontWeight: FontWeight.w700,
                color: color,
              ),
            ),
          ),
          const SizedBox(width: 12),
          Expanded(
            child: Text(
              user['name'] as String,
              style: GoogleFonts.outfit(
                fontSize: 14,
                fontWeight: isYou ? FontWeight.w700 : FontWeight.w500,
                color: isDark
                    ? const Color(0xFFE8E0FF)
                    : const Color(0xFF1A1A2E),
              ),
            ),
          ),
          Text(
            '${user['xp']} XP',
            style: GoogleFonts.outfit(
              fontSize: 13,
              fontWeight: FontWeight.w700,
              color: color,
            ),
          ),
        ],
      ),
    );
  }
}
